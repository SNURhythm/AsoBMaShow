@@ -0,0 +1,15 @@
+package com.snurhythm.asobmashow;
+import android.content.Context;
+import android.view.MotionEvent;
+import android.view.View;
+import org.libsdl.app.SDLSurface;
+final class AsoBMaShowSurface extends SDLSurface {
+ AsoBMaShowSurface(Context context) {super(context);}
+ @Override public boolean onTouch(View view, MotionEvent event) {
+  long entryNanos=System.nanoTime();
+  nativeBeginTouchSegments(event.getEventTime()*1000000L,entryNanos);
+  try {return super.onTouch(view,event);} finally {nativeEndTouchSegments(System.nanoTime());}
+ }
+ private static native void nativeBeginTouchSegments(long sourceNanos,long javaNanos);
+ private static native void nativeEndTouchSegments(long javaNanos);
+}
