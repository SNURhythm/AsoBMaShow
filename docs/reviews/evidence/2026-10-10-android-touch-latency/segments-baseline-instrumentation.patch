diff --git a/src/perf/AndroidTouchSegments.h b/src/perf/AndroidTouchSegments.h
new file mode 100644
index 00000000..4a74966e
--- /dev/null
+++ b/src/perf/AndroidTouchSegments.h
@@ -0,0 +1,52 @@
+#pragma once
+// Measurement-only synchronous Android touch boundaries. Does not change routing.
+#include "LatencyTelemetry.h"
+#include <SDL3/SDL_log.h>
+#include <time.h>
+namespace perf::touch_segments {
+enum Stage { SourceJava, SourceRoute, JavaBegin, JavaRoute, RouteGameplay, GameplayEnqueue, JavaEnqueue, JavaReturn, Count };
+inline constexpr const char *names[] = {"event-to-java", "event-to-route", "java-to-probe-jni", "java-to-route", "route-to-gameplay", "gameplay-to-enqueue", "java-to-enqueue", "java-handler"};
+class FineHistogram {
+  std::array<std::atomic_uint64_t, 16386> buckets{};
+  std::atomic_uint64_t maximum{0};
+public:
+  void record(std::uint64_t us) {
+    auto max=maximum.load(std::memory_order_relaxed);
+    while(us>max && !maximum.compare_exchange_weak(max,us,std::memory_order_relaxed)) {}
+    buckets[std::min<std::uint64_t>(us,16385)].fetch_add(1,std::memory_order_relaxed);
+  }
+  void log(const char *name) {
+    std::array<std::uint64_t,16386> counts{};
+    std::uint64_t n=0;
+    for(std::size_t i=0;i<counts.size();++i) { counts[i]=buckets[i].load(std::memory_order_relaxed);n+=counts[i]; }
+    if(!n)return;
+    const auto max=maximum.load(std::memory_order_relaxed);
+    auto percentile=[&](unsigned p) { std::uint64_t total=0; for(std::size_t i=0;i<counts.size();++i) { total+=counts[i]; if(total>=(n*p+99)/100)return i==16385?max:static_cast<std::uint64_t>(i); }return max;};
+    SDL_Log("TouchSegments %s n=%llu p50=%llu p95=%llu p99=%llu max=%llu us",name,
+      (unsigned long long)n,(unsigned long long)percentile(50),(unsigned long long)percentile(95),(unsigned long long)percentile(99),(unsigned long long)max);
+  }
+};
+inline std::array<FineHistogram,Count> histograms;
+inline std::atomic_uint64_t missing{0};
+struct Sample { std::int64_t source=0,java=0,begin=0,route=0,gameplay=0; bool enqueued=false; };
+inline thread_local Sample sample;
+inline std::int64_t clockOffset() {
+ static const auto offset=[] {timespec t{};clock_gettime(CLOCK_MONOTONIC,&t);return latency::nowMicros()-(static_cast<std::int64_t>(t.tv_sec)*1000000+t.tv_nsec/1000);}();return offset;
+}
+inline void begin(std::int64_t sourceNanos,std::int64_t javaNanos) {
+ const auto now=latency::nowMicros(); const auto offset=clockOffset();
+ sample={sourceNanos/1000+offset,javaNanos/1000+offset,now,0,0,false};
+}
+inline void route() {if(sample.java>0) {sample.route=latency::nowMicros();sample.gameplay=0;}}
+inline void gameplay() {if(sample.java>0)sample.gameplay=latency::nowMicros();}
+inline void record(Stage stage,std::int64_t start,std::int64_t end) {if(start>0 && end>=start)histograms[stage].record(end-start);}
+inline void enqueue() {
+ const auto now=latency::nowMicros();
+ if(sample.java<=0 || sample.route<=0 || sample.gameplay<=0) {missing.fetch_add(1,std::memory_order_relaxed);return;}
+ record(SourceJava,sample.source,sample.java);record(SourceRoute,sample.source,sample.route);record(JavaBegin,sample.java,sample.begin);
+ record(JavaRoute,sample.java,sample.route);record(RouteGameplay,sample.route,sample.gameplay);
+ record(GameplayEnqueue,sample.gameplay,now);record(JavaEnqueue,sample.java,now);sample.enqueued=true;
+}
+inline void end(std::int64_t javaNanos) {if(sample.enqueued)record(JavaReturn,sample.java,javaNanos/1000+clockOffset());sample={};}
+inline void log() {for(unsigned i=0;i<Count;++i)histograms[i].log(names[i]);SDL_Log("TouchSegments missing=%llu",(unsigned long long)missing.load());}
+}
