diff --git a/src/perf/AndroidBaselineTouchProbe.h b/src/perf/AndroidBaselineTouchProbe.h
new file mode 100644
index 00000000..3e586cfa
--- /dev/null
+++ b/src/perf/AndroidBaselineTouchProbe.h
@@ -0,0 +1,58 @@
+#pragma once
+
+// Measurement-only bridge for the pre-branch Android build. Original SDL
+// timestamps and gameplay behavior remain untouched; this table carries a
+// separate Android source timestamp through the existing SDL event queue.
+#include "LatencyTelemetry.h"
+#include <SDL3/SDL_events.h>
+#include <array>
+#include <atomic>
+#include <mutex>
+
+namespace perf::android_baseline {
+inline thread_local std::int64_t javaSourceMicros = 0;
+inline thread_local std::int64_t routedSourceMicros = 0;
+struct Entry {
+  Uint64 timestamp = 0;
+  SDL_TouchID touch = 0;
+  SDL_FingerID finger = 0;
+  Uint32 type = 0;
+  std::int64_t sourceMicros = 0;
+};
+inline std::array<Entry, 4096> entries{};
+inline std::size_t cursor = 0;
+inline std::mutex mutex;
+inline std::atomic_uint64_t matched{0}, missing{0};
+inline bool SDLCALL recordSdlEvent(void *, SDL_Event *event) {
+  if (javaSourceMicros <= 0 || event == nullptr ||
+      (event->type != SDL_EVENT_FINGER_DOWN &&
+       event->type != SDL_EVENT_FINGER_UP &&
+       event->type != SDL_EVENT_FINGER_MOTION &&
+       event->type != SDL_EVENT_FINGER_CANCELED)) return true;
+  std::lock_guard lock(mutex);
+  entries[cursor++ % entries.size()] = {
+      event->tfinger.timestamp, event->tfinger.touchID,
+      event->tfinger.fingerID, event->type, javaSourceMicros};
+  return true;
+}
+inline std::int64_t takeSource(const SDL_Event &event) {
+  std::lock_guard lock(mutex);
+  for (std::size_t n = 0; n < entries.size() && n < cursor; ++n) {
+    auto &entry = entries[(cursor - n - 1) % entries.size()];
+    if (entry.sourceMicros > 0 && entry.timestamp == event.tfinger.timestamp &&
+        entry.touch == event.tfinger.touchID && entry.finger == event.tfinger.fingerID &&
+        entry.type == event.type) {
+      const auto source = entry.sourceMicros;
+      entry.sourceMicros = 0;
+      matched.fetch_add(1, std::memory_order_relaxed);
+      return source;
+    }
+  }
+  missing.fetch_add(1, std::memory_order_relaxed);
+  return 0;
+}
+struct RoutingScope {
+  explicit RoutingScope(const SDL_Event &event) { routedSourceMicros = takeSource(event); }
+  ~RoutingScope() { routedSourceMicros = 0; }
+};
+} // namespace perf::android_baseline
