@@ -0,0 +1,19 @@
+package com.snurhythm.asobmashow;
+
+import android.content.Context;
+import android.view.MotionEvent;
+import android.view.View;
+import org.libsdl.app.SDLSurface;
+
+// Measurement-only wrapper: retain the original pre-branch SDL touch path.
+final class AsoBMaShowSurface extends SDLSurface {
+    AsoBMaShowSurface(Context context) { super(context); }
+    private static native void nativeBeginTouchProbe(long uptimeNanos);
+    private static native void nativeEndTouchProbe();
+    @Override
+    public boolean onTouch(View view, MotionEvent event) {
+        nativeBeginTouchProbe(event.getEventTime() * 1000000L);
+        try { return super.onTouch(view, event); }
+        finally { nativeEndTouchProbe(); }
+    }
+}
