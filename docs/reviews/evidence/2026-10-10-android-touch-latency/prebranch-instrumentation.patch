+  static const std::int64_t offset = [] {
+    timespec monotonic{};
+    clock_gettime(CLOCK_MONOTONIC, &monotonic);
+    return perf::latency::nowMicros() -
+        (static_cast<std::int64_t>(monotonic.tv_sec) * 1000000 + monotonic.tv_nsec / 1000);
+  }();
+  perf::android_baseline::javaSourceMicros = uptimeNanos / 1000 + offset;
+}
