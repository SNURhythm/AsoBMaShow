{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "asobmashow",
    "version": "0.0.1",
    "builtin-baseline": "75a2e14262fc23c1f03bac18e135c4866dd25b51",
    "dependencies": [
        "libsndfile",
        "utf8proc",
        "sdl2",
        "sdl2-ttf",
        {
            "name": "ffmpeg",
            "features": [
                "gpl",
                "x264"
            ]
        },
        {
            "name": "curl",
            "platform": "!ios"
        },
        {
            "name": "libarchive",
            "default-features": false,
            "features": [
                "bzip2",
                "lz4",
                "lzma",
                "zstd"
            ]
        },
        "7zip",
        {
            "name": "unarr",
            "platform": "!ios & !windows"
        },
        {
            "name": "lua",
            "platform": "!android"
        },
        {
            "name": "luajit",
            "platform": "!android"
        },
        {
            "name": "portaudio",
            "features": [
                "asio"
            ],
            "platform": "windows"
        },
        {
            "name": "portaudio",
            "platform": "!windows & !android"
        }
    ],
    "overrides": [
        {
            "name": "libsndfile",
            "version": "1.2.2"
        },
        {
            "name": "luajit",
            "version-date": "2026-07-11"
        }
    ]
}
