include_guard(GLOBAL)

# Keep classification separate from registration: platform-only tests may not
# exist in this configuration, and existing labels/fixture properties survive.
function(asobmashow_label_tests label)
    set_property(DIRECTORY APPEND PROPERTY ASOBMASHOW_TEST_GROUPS "${label}")
    foreach(test_name IN LISTS ARGN)
        if(TEST "${test_name}")
            set_property(TEST "${test_name}" APPEND PROPERTY LABELS "${label}")
        endif()
    endforeach()
endfunction()

# Used for aliases, Python wrappers and helpers needed at test execution time.
# Tests named after their native target are discovered automatically.
function(asobmashow_test_build_targets test_name)
    if(TEST "${test_name}")
        set_property(TEST "${test_name}" APPEND PROPERTY ASOBMASHOW_BUILD_TARGETS ${ARGN})
    endif()
endfunction()

function(asobmashow_finalize_test_groups)
    get_property(all_tests DIRECTORY PROPERTY TESTS)
    get_property(groups DIRECTORY PROPERTY ASOBMASHOW_TEST_GROUPS)
    list(REMOVE_DUPLICATES groups)
    foreach(test_name IN LISTS all_tests)
        get_property(labels TEST "${test_name}" PROPERTY LABELS)
        if(NOT "${labels}" MATCHES "(^|;)area_")
            message(FATAL_ERROR "Unclassified test: ${test_name}. Add it to cmake/TestGroupCatalog.cmake.")
        endif()
        get_property(build_targets TEST "${test_name}" PROPERTY ASOBMASHOW_BUILD_TARGETS)
        if(NOT build_targets AND TARGET "${test_name}")
            set_property(TEST "${test_name}" PROPERTY ASOBMASHOW_BUILD_TARGETS "${test_name}")
        endif()
        foreach(property FIXTURES_SETUP FIXTURES_CLEANUP)
            get_property(fixtures TEST "${test_name}" PROPERTY ${property})
            foreach(fixture IN LISTS fixtures)
                list(APPEND fixture_tests_${fixture} "${test_name}")
            endforeach()
        endforeach()
    endforeach()

    foreach(group IN LISTS groups)
        set(pending)
        foreach(test_name IN LISTS all_tests)
            get_property(labels TEST "${test_name}" PROPERTY LABELS)
            if(group IN_LIST labels)
                list(APPEND pending "${test_name}")
            endif()
        endforeach()
        if(NOT pending)
            continue()
        endif()
        set(visited)
        set(build_targets)
        # CTest includes setup/cleanup fixtures even when their labels do not
        # match -L. Build the same transitive closure, without relabeling them.
        while(pending)
            list(POP_FRONT pending test_name)
            if(test_name IN_LIST visited)
                continue()
            endif()
            list(APPEND visited "${test_name}")
            get_property(targets TEST "${test_name}" PROPERTY ASOBMASHOW_BUILD_TARGETS)
            foreach(target IN LISTS targets)
                if(NOT TARGET "${target}")
                    message(FATAL_ERROR "Test ${test_name} requires unknown build target ${target}")
                endif()
                list(APPEND build_targets "${target}")
            endforeach()
            get_property(fixtures TEST "${test_name}" PROPERTY FIXTURES_REQUIRED)
            foreach(fixture IN LISTS fixtures)
                list(APPEND pending ${fixture_tests_${fixture}})
            endforeach()
        endwhile()
        string(REGEX REPLACE "^area_" "" target_suffix "${group}")
        add_custom_target(tests_${target_suffix})
        if(build_targets)
            list(REMOVE_DUPLICATES build_targets)
            add_dependencies(tests_${target_suffix} ${build_targets})
        endif()
    endforeach()
endfunction()
