{"tutorial.controls.back", "Back", "이전", "戻る", "返回", "返回"},
{"tutorial.controls.begin", "Start tour", "안내 시작", "ガイド開始", "开始导览", "開始導覽"},
{"tutorial.controls.finish", "Done", "완료", "完了", "完成", "完成"},
