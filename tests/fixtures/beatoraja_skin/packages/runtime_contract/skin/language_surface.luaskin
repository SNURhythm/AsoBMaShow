assert(type(_G) == "table")
assert(type(assert) == "function")
assert(type(pcall) == "function")
assert(type(xpcall) == "function")
assert(type(pairs) == "function")
assert(type(ipairs) == "function")
assert(type(table) == "table")
assert(type(string) == "table")
assert(type(math) == "table")
assert(type(coroutine) == "table")
assert(type(package) == "table")
assert(type(bit32) == "table")

assert(collectgarbage == nil)
assert(gcinfo == nil)
assert(newproxy == nil)
assert(module == nil)
assert(package.searchers == nil)
assert(package.loadlib == nil)
assert(package.cpath == nil)
assert(string.dump == nil)

assert(bit32.band(0xfff0, 0xff) == 240)
assert(bit32.bor(0xf00, 0xff) == 4095)
assert(bit32.bxor(0xf0, 0x0f) == 255)
assert(bit32.bnot(0) == 4294967295)
assert(bit32.lshift(1, 31) == 2147483648)
assert(bit32.rshift(4294967294, 1) == 2147483647)
assert(bit32.arshift(4294967294, 1) == 4294967295)
assert(bit32.extract(240, 4, 4) == 15)
assert(bit32.replace(42245, 10, 4, 4) == 42405)

local dynamic, dynamic_error = loadstring("return 11")
assert(type(dynamic) == "function" and dynamic_error == nil)
assert(dynamic() == 11)
local loaded, loaded_error = load("return 13")
assert(type(loaded) == "function" and loaded_error == nil)
assert(loaded() == 13)
local binary = string.char(27) .. "Lua"
assert(select(1, loadstring(binary)) == nil)
assert(select(1, load(binary)) == nil)
assert(not pcall(dofile, "binary.lua"))

return { phase = skin_config and "configured" or "header" }
