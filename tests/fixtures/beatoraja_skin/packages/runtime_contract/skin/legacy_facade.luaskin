local first = require("luajava")
local second = require("luajava")
assert(first == second and first == luajava)
local exports = 0
for _ in pairs(luajava) do exports = exports + 1 end
assert(exports == 3)
assert(type(luajava.bindClass) == "function")
assert(type(luajava.new) == "function")
assert(type(luajava.newInstance) == "function")

local File = luajava.bindClass("java.io.File")
assert(type(File) == "table" and next(File) == nil)
local directory = luajava.new(File, ".")
local members = 0
for key in pairs(directory) do
  assert(key == "listFiles" or key == "mkdir")
  members = members + 1
end
assert(members == 2)
assert(not pcall(function() return directory:getAbsolutePath() end))
assert(not pcall(function() return directory:getAbsolutePath() end))
local listed = directory:listFiles()
assert(type(listed) == "table" and #listed > 0)
for _, path in ipairs(listed) do
  assert(type(path) == "string")
  assert(path:match("^/") or path:match("^%a:/"))
  assert(path:find("RuntimeContract", 1, true))
end
assert(luajava.new(File, "legacy-created"):mkdir() == true)

local Gdx = luajava.bindClass("com.badlogic.gdx.Gdx")
assert(type(Gdx) == "table" and Gdx.app == nil)
assert(type(Gdx.graphics) == "table" and type(Gdx.input) == "table")
assert(Gdx.graphics:getWidth() == 0 and Gdx.graphics:getHeight() == 0)
local Input = luajava.bindClass("com.badlogic.gdx.Input")
assert(Input.Keys.A == 29 and Input.Keys["not a key"] == -1)
local Controllers = luajava.bindClass("com.badlogic.gdx.controllers.Controllers")
local controllers = Controllers:getControllers()
assert(controllers.size == 0 and controllers:first() == nil)
local Controller = luajava.bindClass("com.badlogic.gdx.controllers.Controller")
assert(next(Controller) == nil)
assert(not pcall(function() return Gdx.files end))
assert(not pcall(luajava.new, {}, "."))
assert(not pcall(luajava.new, File, ".", "extra"))
assert(not pcall(luajava.new, File, 123))
assert(not pcall(luajava.bindClass, "java.net.URL"))
assert(not pcall(luajava.bindClass, "java.net.URL"))
assert(not pcall(luajava.bindClass, "com.badlogic.gdx.graphics.GL20"))

return { phase = skin_config and "configured" or "header" }
