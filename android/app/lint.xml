<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      These permission checks are confined to optional upstream SDL features.
      Bluetooth HID initialization checks BLUETOOTH_CONNECT before entering
      these paths, and AsoBMaShow never opens SDL audio capture.
    -->
    <issue id="MissingPermission">
        <ignore path="../../SDL/android-project/app/src/main/java/org/libsdl/app/HIDDeviceBLESteamController.java" />
        <ignore path="../../SDL/android-project/app/src/main/java/org/libsdl/app/HIDDeviceManager.java" />
        <ignore path="../../SDL/android-project/app/src/main/java/org/libsdl/app/SDLAudioManager.java" />
    </issue>
    <!-- SDLActivity instantiates SDLGenericMotionListener_API29 only on API 29+. -->
    <issue id="NewApi">
        <ignore regexp="Call requires API level 29 .*android\.view\.InputDevice#isExternal" />
    </issue>
    <!-- SDL3 uses the flagged USB receiver overload on API 33+; this is its older-API branch. -->
    <issue id="UnspecifiedRegisterReceiverFlag">
        <ignore regexp="`mUsbBroadcast` is missing `RECEIVER_EXPORTED` or `RECEIVER_NOT_EXPORTED` flag for unprotected broadcasts registered for org\.libsdl\.app\.USB_PERMISSION" />
    </issue>
</lint>
