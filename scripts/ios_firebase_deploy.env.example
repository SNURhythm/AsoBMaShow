# Shell-compatible template for scripts/ios_firebase_deploy.sh.
# Keep real copies out of git. Use .env.local, ios/Xcode/AsoBMaShow/.env.local,
# or pass a private file with:
#   scripts/ios_firebase_deploy.sh --env-file /path/to/private.env

# Signing and App Store Connect auth used by fastlane match/build_app.
# For APP_STORE_KEY, either paste the .p8 key content or load it from a file:
#   APP_STORE_KEY="$(cat /absolute/path/to/AuthKey_${APP_STORE_KEY_ID}.p8)"
APP_STORE_KEY_ID='7459U6UPUW'
APP_STORE_KEY=''
KEYCHAIN_PASSWORD=''
MATCH_PASSWORD=''
GIT_BASIC_AUTHORIZATION=''

# Optional Apple account values. The lane primarily uses APP_STORE_KEY, but these
# can help if fastlane needs account context on this machine.
FASTLANE_USER='zudevxf@gmail.com'
FASTLANE_PASSWORD=''
FASTLANE_SESSION=''
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=''
SPACESHIP_ONLY_ALLOW_INTERACTIVE_2FA='1'

# Firebase App Distribution target.
# If empty, the plugin can usually infer the app id from GoogleService-Info.plist
# in the archive.
FIREBASE_IOS_APP_ID=''
FIREBASE_APP_DISTRIBUTION_GROUPS='internal'
FIREBASE_APP_DISTRIBUTION_TESTERS=''
FIREBASE_APP_DISTRIBUTION_RELEASE_NOTES=''

# Firebase authentication. Set one of these, or login locally with Firebase CLI
# or gcloud application-default credentials.
# For JSON content, either paste the service account JSON or load it from a file:
#   FIREBASE_SERVICE_CREDENTIALS_JSON="$(cat /absolute/path/to/firebase-service-account.json)"
FIREBASE_SERVICE_CREDENTIALS_JSON=''
FIREBASE_CLI_TOKEN=''
FIREBASE_TOKEN=''
GOOGLE_APPLICATION_CREDENTIALS=''

# Optional local build/cache overrides.
IOS_DEPLOY_CACHE_ROOT="${HOME}/Library/Caches/AsoBMaShow/ios-deploy"
IOS_DERIVED_DATA_PATH="${HOME}/Library/Developer/Xcode/DerivedData/AsoBMaShow-FirebaseCI"

# Optional GitHub metadata used for local release notes/build number.
GITHUB_RUN_NUMBER=''
GITHUB_HEAD_REF=''
GITHUB_SHA=''
