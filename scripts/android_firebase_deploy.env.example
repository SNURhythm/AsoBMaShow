# Shell-compatible template for scripts/android_firebase_deploy.sh.
# Keep real copies out of git. Use .env.local, android/.env.local,
# or pass a private file with:
#   scripts/android_firebase_deploy.sh --env-file /path/to/private.env

# Android SDK and native dependency paths.
# Homebrew android-commandlinetools commonly installs here:
ANDROID_HOME='/opt/homebrew/share/android-commandlinetools'
ANDROID_SDK_ROOT="${ANDROID_HOME}"
VCPKG_ROOT='/Users/xf/vcpkg'

# Build metadata. Leave ANDROID_VERSION_CODE empty for automatic handling.
# Build-only and deploy runs both use a compact UTC timestamp versionCode.
ANDROID_VERSION_CODE=''
ANDROID_VERSION_NAME=''
GITHUB_RUN_NUMBER=''
GITHUB_HEAD_REF=''
GITHUB_SHA=''

# Firebase App Distribution target.
FIREBASE_ANDROID_APP_ID=''
FIREBASE_PROJECT=''
FIREBASE_APP_DISTRIBUTION_GROUPS='internal'
FIREBASE_APP_DISTRIBUTION_TESTERS=''
FIREBASE_APP_DISTRIBUTION_RELEASE_NOTES=''

# Firebase authentication. Set one of these, or login locally with Firebase CLI
# or gcloud application-default credentials.
# For JSON content, either paste the service account JSON or load it from a file:
#   FIREBASE_SERVICE_CREDENTIALS_JSON="$(cat /absolute/path/to/firebase-service-account.json)"
FIREBASE_SERVICE_CREDENTIALS_JSON=''
FIREBASE_CLI_TOKEN=''
FIREBASE_TOKEN=''
GOOGLE_APPLICATION_CREDENTIALS=''

# Optional CLI override.
FIREBASE_CLI_BIN='firebase'
